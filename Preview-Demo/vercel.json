{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pipeline",
      "destination": "/pipeline.html"
    },
    {
      "source": "/v1/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/v2/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/v3/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
