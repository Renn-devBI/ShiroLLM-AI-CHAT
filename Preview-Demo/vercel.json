{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pipeline",
      "destination": "/pipeline.html"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1/:path*"
    },
    {
      "source": "/v2/:path*",
      "destination": "/api/v2/:path*"
    },
    {
      "source": "/v3/:path*",
      "destination": "/api/v3/:path*"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
