{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/Preview-Demo/public/static/$1"
    },
    {
      "source": "/pipeline",
      "destination": "/Preview-Demo/public/pipeline.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/Preview-Demo/public/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/Preview-Demo/public/index.html"
    },
    {
      "source": "/",
      "destination": "/Preview-Demo/public/index.html"
    }
  ]
}
